# ──────────────────────────────────────────────────────────────
# Azure VM Diagnosis Agent —— 环境变量样例
# 复制为 .env 后填值：cp .env.example .env
# ──────────────────────────────────────────────────────────────

# ── Azure 订阅 ──────────────────────────────────────────────
AZURE_SUBSCRIPTION_ID=00000000-0000-0000-0000-000000000000

# ── 鉴权模式（只允许 spn 或 cli）─────────────────────────────
#   spn —— Service Principal（生产推荐，只需 Reader + Monitoring Reader 角色）
#   cli —— 复用 az login 缓存（本地调试用；az login 后即可）
AZURE_AUTH_MODE=spn

# spn 模式必填；cli 模式留空即可
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=

# 用户消息不带 RG 时用这个默认 RG（强烈建议配置；不配则用户必须每次带 RG）
AZURE_DEFAULT_RESOURCE_GROUP=

# ── Azure OpenAI（主 Agent + 建议生成器共用） ───────────────
AZURE_OPENAI_ENDPOINT=https://xxx.openai.azure.com
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_DEPLOYMENT=gpt-4o
# 建议生成器单独的小模型 deployment（可选；不填则回退到 AZURE_OPENAI_DEPLOYMENT）
AZURE_OPENAI_ADVICE_DEPLOYMENT=

# ── 飞书 ────────────────────────────────────────────────────
FEISHU_APP_ID=
FEISHU_APP_SECRET=
# 飞书 OpenAPI 基础 URL（国内租户改 https://open.feishu.cn；海外 lark 改 https://open.larksuite.com）
FEISHU_BASE_URL=https://open.feishu.cn
# 收到 @ 后立即贴的"已收到"表情类型（GET / OK / THUMBSUP 等）
FEISHU_ACK_REACTION=THINKING

# ── 会话策略 ─────────────────────────────────────────────────
# 闲置多久（秒）清空一个 session；默认 20 分钟
SESSION_IDLE_TTL_SEC=1200
# 单个 session 保留的最大对话轮次（user 消息数），超过自动截断；默认 6
SESSION_MAX_TURNS=6

# ── 日志 ────────────────────────────────────────────────────
APP_LOG_LEVEL=INFO
